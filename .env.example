# Copy this file to .env.local and fill in your own Supabase project values.
# Find these at supabase.com -> your project -> Connect button (top of page).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Find at Supabase -> Project Settings -> API -> "service_role"
# secret (or the new "secret" key). NEVER prefix with NEXT_PUBLIC_ — used only
# inside API routes (user/admin management, file-extraction upload).
SUPABASE_SERVICE_ROLE_KEY=
